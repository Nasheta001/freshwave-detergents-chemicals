# Public address of the site (used for SEO links and the sitemap)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# PostgreSQL connection. If left empty, a local embedded Postgres (PGlite) is used in ./.data - fine for trying the site, not for production.
DATABASE_URL=
# Set to true if your database host requires SSL
DATABASE_SSL=false

# Long random string used to sign admin sessions (required in production)
AUTH_SECRET=

# First admin account. Created automatically on first start if no admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where uploaded product photos and SDS files are stored
UPLOAD_DIR=./uploads
